# Live gameplay transport for non-authoritative games: supabase | socket
VITE_GAME_RT=supabase

# Required by authoritative Micro Soccer even when other games use Supabase.
# Use the public HTTPS service URL in production.
VITE_GAME_RT_URL=http://127.0.0.1:3001

# Micro Soccer v2 rollout: shadow keeps legacy rendering; render enables
# full-world prediction. Use off only for diagnostics.
VITE_SOC_PREDICTION_MODE=render

# Legacy snapshot render delay used only in shadow/off mode (80-120 ms).
VITE_SOC_RENDER_DELAY_MS=100
