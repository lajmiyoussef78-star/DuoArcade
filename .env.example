# Live gameplay transport: supabase (default) | socket
VITE_GAME_RT=supabase

# Socket.IO game server (used when VITE_GAME_RT=socket)
VITE_GAME_RT_URL=http://127.0.0.1:3001

# Micro Soccer snapshot experiment ONLY (host st / guest pose tick). Default 20.
# VITE_SOC_NET_HZ=20
# VITE_SOC_NET_HZ=60
# Or set interval directly (ms); wins over HZ if set:
# VITE_SOC_NET_INTERVAL_MS=50
# VITE_SOC_NET_INTERVAL_MS=16.666
