# DuoArcade game server (Socket.IO)
PORT=3001
HOST=0.0.0.0

# Comma-separated origins allowed in development (Vite + common localhost variants).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Socket.IO engine heartbeat (ms).
PING_INTERVAL_MS=10000
PING_TIMEOUT_MS=20000

# Required for JWT validation (same project as the React app).
# Use the anon/publishable key — auth.getUser(jwt) verifies the access token.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Reject join-room unless JWT user is a member of the duo / friend match (1=on, 0=off).
ROOM_AUTH=1

# Max JSON size for relayed `m` game payloads (bytes).
MAX_PAYLOAD_BYTES=16384

# Authoritative Micro Soccer. Physics is always fixed at 60 Hz.
SOCCER_SNAPSHOT_HZ=20
SOCCER_INPUT_TIMEOUT_MS=250
SOCCER_INPUT_RATE_LIMIT=40
SOCCER_DISCONNECT_GRACE_MS=10000
SOCCER_FINISHED_RETENTION_MS=30000
